{
  "name": "event-horizon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Fly a ship around a real black hole, traced live through curved spacetime. Two clocks run: yours and Earth's.",
  "homepage": "https://pratyushshivam.github.io/event-horizon/",
